#!/usr/bin/env python3
# ==================================================
#   ASLKEAR -Android Open-App Auto Checker
#   Run in Termux:
#   curl -sL <URL> | python3
# ==================================================
import subprocess, json, os, sys
from urllib.request import urlopen

Y   = "\033[93m"
R   = "\033[91m"
G   = "\033[92m"
C   = "\033[96m"
W   = "\033[0m"
DIM = "\033[90m"
BLD = "\033[1m"

score  = 0
issues = []

def run(cmd, timeout=10):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True,
                           text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""

def run2(cmd, timeout=10):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True,
                           text=True, timeout=timeout)
        return r.stdout.strip(), r.stderr.strip()
    except Exception:
        return "", ""

def fetch(url, timeout=10):
    try:
        with urlopen(url, timeout=timeout) as r:
            return r.read().decode()
    except Exception:
        return ""

def head(t):
    print(f"\n{Y}{BLD}{'-'*50}\n  {t}\n{'-'*50}{W}")

def ok(t):
    print(f"  {G}[OK]{W}  {t}")

def warn(t, pts=10):
    global score
    score += pts
    issues.append((t, pts))
    print(f"  {R}[!!]{W}  {t}")

def info(t):
    print(f"  {C} > {W} {t}")

def dim(t):
    print(f"  {DIM}{t}{W}")

# ==================================================
print(f"\n{Y}{BLD}{'='*50}")
print("   ASLKEAR  -  ANDROID OPEN-APP CHECKER")
print(f"{'='*50}{W}")

# -------------------------------------------------
# 0. DEVICE INFO
# -------------------------------------------------
head("0 / Device Info")
info(f"Device  : {run('getprop ro.product.brand')} {run('getprop ro.product.model')}")
info(f"Android : {run('getprop ro.build.version.release')}  (SDK {run('getprop ro.build.version.sdk')})")
info(f"Build   : {run('getprop ro.build.tags')}")

# -------------------------------------------------
# 1. ROOT PATH DETECTION
# -------------------------------------------------
head("1 / Root Path Detection")

ROOT_PATHS = [
    ('/system/bin/su',                    'su binary'),
    ('/system/xbin/su',                   'su binary (xbin)'),
    ('/sbin/su',                          'su binary (sbin)'),
    ('/su/bin/su',                        'su binary (su/)'),
    ('/system/app/Superuser.apk',         'Superuser APK'),
    ('/system/framework/XposedBridge.jar','Xposed Framework'),
    ('/sys/fs/susfs',                     'SuSFS'),
    ('/dev/magisk',                       'Magisk device'),
]
PRIV_PATHS = [
    ('/data/adb/magisk',    'Magisk',       50),
    ('/data/adb/magisk.db', 'Magisk DB',    50),
    ('/data/adb/ksud',      'KernelSU',     50),
    ('/data/adb/ksu',       'KernelSU dir', 50),
    ('/data/adb/apatch',    'APatch',       50),
]

found_any = False
for path, label in ROOT_PATHS:
    if os.path.exists(path):
        warn(f"[{label}] found at {path}", 30)
        found_any = True

for path, label, pts in PRIV_PATHS:
    out, err = run2(f"ls '{path}' 2>&1")
    full = (out + err).lower()
    if 'no such' not in full and 'permission denied' not in full and 'not permitted' not in full and out:
        warn(f"[{label}] found at {path}", pts)
        found_any = True

# Check su -ignore Termux's own stub
su_path = run("which su 2>/dev/null")
if su_path and 'com.termux' not in su_path:
    su_test = run("su -c id 2>/dev/null")
    if 'uid=0' in su_test:
        warn(f"su command works (root confirmed): {su_path}", 50)
        found_any = True

if not found_any:
    ok("No root / Magisk / KernelSU / APatch paths found")

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# ZYGISK SOCKET DETECTION
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
head("1b / Zygisk + Magisk Socket Detection")

unix_raw = run("cat /proc/net/unix 2>/dev/null")
zygisk_hits = [l.strip() for l in unix_raw.splitlines()
               if any(x in l.lower() for x in ['@zygisk','@magisk_daemon','@magiskd'])]

if zygisk_hits:
    for h in zygisk_hits[:4]:
        warn(f"Zygisk/Magisk socket found: {h[-60:]}", 50)
else:
    ok("No Zygisk / Magisk sockets in /proc/net/unix")

# Direct socket connect (bypasses Shamiko /proc/net/unix hiding)
import socket as _sock
for sock_name in [b'\x00magisk_daemon', b'\x00magiskd', b'\x00zygisk_daemon']:
    try:
        s = _sock.socket(_sock.AF_UNIX, _sock.SOCK_STREAM)
        s.settimeout(1)
        s.connect(sock_name)
        warn(f"Magisk socket responded: {sock_name[1:].decode()} [Shamiko bypass]", 60)
        s.close()
    except ConnectionRefusedError:
        warn(f"Socket exists but refused: {sock_name[1:].decode()} [suspicious]", 40)
    except Exception:
        pass

ok("No Magisk socket connection") if not any(
    x[0].startswith('Magisk socket') or x[0].startswith('Socket exists')
    for x in issues[-6:]
) else None

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# MOUNT NAMESPACE MISMATCH (Shamiko detection)
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
head("1d / Mount Namespace Mismatch (Shamiko)")

try:
    pid1_count = int(run("cat /proc/1/mountinfo 2>/dev/null | wc -l") or 0)
    self_count  = int(run("cat /proc/self/mountinfo 2>/dev/null | wc -l") or 0)
    diff = abs(pid1_count - self_count)
    info(f"PID 1 mounts: {pid1_count}  |  Self mounts: {self_count}  |  Diff: {diff}")
    if diff > 40:
        warn(f"Mount namespace mismatch: diff={diff} - Shamiko manipulation suspected", 50)
    elif diff > 20:
        warn(f"Mount namespace difference: diff={diff} - slightly suspicious", 20)
    else:
        ok(f"Mount namespace consistent (diff={diff})")
except Exception:
    dim("Could not compare mount namespaces")

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# PLAY INTEGRITY SIGNAL
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
head("1c / Play Integrity Signal")

vbs  = run("getprop ro.boot.verifiedbootstate")
vbmeta = run("getprop ro.boot.vbmeta.device_state")
print(f"  {DIM}ro.boot.verifiedbootstate   = {vbs or '(empty)'}{W}")
print(f"  {DIM}ro.boot.vbmeta.device_state = {vbmeta or '(empty)'}{W}")

if vbs == 'green' and vbmeta == 'locked':
    ok("Boot state: VERIFIED GREEN + LOCKED -  Play Integrity likely PASSES")
elif vbs in ('yellow','orange') or vbmeta == 'unlocked':
    warn(f"Boot state: {vbs} / {vbmeta} - Play Integrity likely FAILS", 40)
else:
    warn(f"Boot state unknown: {vbs} / {vbmeta}", 20)

# -------------------------------------------------
# 2. SYSTEM PROPERTIES
# -------------------------------------------------
head("2 / System Properties")

PROPS = [
    ('ro.build.tags',               'release-keys', False),
    ('ro.debuggable',               '0',            False),
    ('ro.secure',                   '1',            False),
    ('ro.allow.mock.location',      '0',            False),
    ('ro.boot.verifiedbootstate',   'green',        False),
    ('ro.boot.vbmeta.device_state', 'locked',       False),
    # sys.oem_unlock_allowed skipped -always 1 on Xiaomi/POCO (false positive)
    ('persist.zygisk.enable',       '1',            True),
    ('persist.susfs.enabled',       '1',            True),
]

prop_ok = True
for prop, expected, flag_if_eq in PROPS:
    val = run(f"getprop {prop}")
    display = val if val else "(empty)"
    if flag_if_eq:
        if val == expected:
            warn(f"{prop} = {display}  [SUSPICIOUS]", 20)
            prop_ok = False
        else:
            dim(f"{prop} = {display}")
    else:
        if val and val != expected:
            warn(f"{prop} = {display}  [expected: {expected}]", 20)
            prop_ok = False
        else:
            dim(f"{prop} = {display}")

if prop_ok:
    ok("All system properties look clean")

# -------------------------------------------------
# 3. DANGEROUS PACKAGES
# -------------------------------------------------
head("3 / Dangerous Package Detection")

DANGER = {
    'com.topjohnwu.magisk':             ('Magisk',          50),
    'io.github.vvb2060.magisk':         ('Magisk Alpha',    50),
    'me.weishu.kernelsu':               ('KernelSU',        50),
    'com.rifsxd.ksunext':               ('KernelSU Next',   50),
    'com.bmax121.apatch':               ('APatch',          50),
    'de.robv.android.xposed.installer': ('Xposed',          40),
    'io.github.lsposed':                ('LSPosed',         40),
    'org.lsposed.manager':              ('LSPosed Manager', 40),
    'me.weishu.exposed':                ('TaiChi',          40),
    'com.noshufou.android.su':          ('SuperUser',       30),
    'eu.chainfire.supersu':             ('SuperSU',         30),
    'com.koushikdutta.superuser':       ('Superuser (CW)',  30),
    'com.mt.mtfile':                    ('MT Manager',      25),
    'com.ztheater.mt':                  ('MT Manager',      25),
    'catch_.me_.if_.you_.can_':         ('GameGuardian',    30),
    'ru.zdevs.zarchiver':               ('ZArchiver',       10),
    'com.lbe.parallel.intl':            ('Parallel Space',  20),
    'com.excelliance.dualaid':          ('Dual Space',      20),
    'com.lexa.fakegps':                 ('Fake GPS',        20),
    'com.incorporateapps.fakegps.fre':  ('Fake GPS Free',   20),
    # Play Integrity bypass tools
    'com.chiteroman.playintegrityfix':       ('PlayIntegrityFix',  50),
    'io.github.chiteroman.playintegrityfix': ('PlayIntegrityFix',  50),
    'es.chiteroman.playintegrityfix':        ('PlayIntegrityFix',  50),
    'io.github.xposed.trickstore':           ('TrickyStore',       50),
    'com.aviraxp.adblocker':                 ('TrickyStore',       50),
    # Zygisk standalone
    'com.github.rezygisk':                   ('ReZygisk',          40),
    'github.rezygisk':                       ('ReZygisk',          40),
}

pkg_list = run("pm list packages 2>/dev/null")
found_pkgs = []
for pkg, (name, pts) in DANGER.items():
    if pkg in pkg_list:
        found_pkgs.append((name, pkg, pts))

if found_pkgs:
    for name, pkg, pts in found_pkgs:
        warn(f"[{name}] installed  [{pkg}]", pts)
else:
    ok("No suspicious packages found")

# -------------------------------------------------
# 4. MOUNT ANALYSIS
# -------------------------------------------------
head("4 / Mount Namespace Analysis")

mounts_raw = run("cat /proc/mounts 2>/dev/null") or \
             run("cat /proc/self/mountinfo 2>/dev/null")
mount_lines = [l for l in mounts_raw.splitlines() if l.strip()]
count = len(mount_lines)
info(f"Mount count: {count}")

if count > 300:
    warn(f"Mount count very high: {count}  [Magisk Magic Mount likely]", 50)
elif count > 250:
    warn(f"Mount count suspicious: {count}", 25)
else:
    ok(f"Mount count normal: {count}")

# Only flag mounts that specifically point to Magisk/KernelSU paths
suspicious = [l.strip() for l in mount_lines
              if any(x in l.lower() for x in ['/data/adb/magisk','/data/adb/modules',
                                               '/data/adb/ksu','/data/adb/apatch','susfs'])]
if suspicious:
    for m in suspicious[:4]:
        warn(f"Suspicious mount: {m[:65]}", 20)
else:
    ok("No Magisk / KernelSU mounts found")

# -------------------------------------------------
# 5. SELINUX
# -------------------------------------------------
head("5 / SELinux Status")

selinux = run("cat /sys/fs/selinux/enforce 2>/dev/null") or \
          run("getenforce 2>/dev/null")
info(f"SELinux: {selinux or '(unreadable)'}")

if selinux in ('0', 'Permissive', 'permissive'):
    warn("SELinux is Permissive -root likely active", 30)
elif selinux in ('1', 'Enforcing', 'enforcing'):
    ok("SELinux is Enforcing")
else:
    dim("SELinux status unknown")

# -------------------------------------------------
# 6. IP + LOCATION + VPN
# -------------------------------------------------
head("6 / IP -Location -VPN Check")

final_ip = ""
raw = fetch("http://ip-api.com/json?fields=status,message,country,countryCode,city,isp,org,proxy,hosting,query")
if raw:
    try:
        d = json.loads(raw)
        if d.get('status') == 'success':
            final_ip = d.get('query', '')
            info(f"IP      : {C}{final_ip}{W}")
            info(f"Country : {d.get('country','?')} / {d.get('city','?')}")
            info(f"ISP     : {d.get('isp','?')}")
            if d.get('proxy') or d.get('hosting'):
                warn("VPN / Proxy detected -NOT allowed", 40)
            elif d.get('countryCode') == 'IR':
                ok("Iran confirmed -no VPN detected")
            else:
                warn(f"Country: {d.get('country','?')} -VPN or outside Iran suspected", 40)
        else:
            warn(f"IP check error: {d.get('message','?')}", 0)
    except Exception:
        warn("Failed to parse IP response", 0)
else:
    warn("Could not reach IP check server", 0)

# -------------------------------------------------
# 7. VPN INTERFACE
# -------------------------------------------------
head("7 / VPN Interface Detection")

ifaces = run("ip addr show 2>/dev/null") or run("ifconfig 2>/dev/null")
VPN_IFACES = ['tun0','tun1','wg0','wg1','ppp0','ipsec0','vpn0']
found_iface = [i for i in VPN_IFACES if i in ifaces]

if found_iface:
    for iface in found_iface:
        warn(f"VPN interface active: {iface}", 35)
else:
    ok("No VPN interfaces found")

# -------------------------------------------------
# 8. DNS CHECK + DNS CHANGER
# -------------------------------------------------
head("8 / DNS Check -DNS Changer Detect")

dns_raw = run("nslookup google.com 2>/dev/null")
if dns_raw:
    for line in dns_raw.splitlines()[:6]:
        dim(line)

DNS_CHANGERS = {
    'Shecan':      ['178.22.122.100', '185.51.200.2'],
    'Electro':     ['78.157.42.100',  '78.157.42.101'],
    '403.online':  ['10.202.10.202',  '10.202.10.102'],
    'Radar':       ['10.202.10.10',   '10.202.10.11'],
    'Begzar':      ['185.55.226.26',  '185.55.225.25'],
    'Cloudflare':  ['1.1.1.1',        '1.0.0.1'],
}

dc_found = None
for name, ips in DNS_CHANGERS.items():
    for ip in ips:
        if ip in dns_raw:
            dc_found = (name, ip)
            break

if dc_found:
    warn(f"DNS changed: {dc_found[0]} ({dc_found[1]}) -NOT allowed", 25)
else:
    ok("No DNS Changer detected")

# -------------------------------------------------
# 9. DNS LEAK TEST
# -------------------------------------------------
head("9 / DNS Leak Test")

cf = fetch("https://1.1.1.1/cdn-cgi/trace")
cf_ip = next((l.split('=')[1] for l in (cf or '').splitlines()
              if l.startswith('ip=')), '')

if cf_ip:
    info(f"Cloudflare edge: {cf_ip}")
    if final_ip and cf_ip != final_ip:
        warn("IP mismatch -DNS Leak suspected", 20)
    else:
        ok("No DNS Leak detected")
else:
    ok("No DNS Leak detected")

# ==================================================
# SUMMARY
# ==================================================
print(f"\n{Y}{BLD}{'='*50}{W}")
print(f"{Y}{BLD}   RESULT SUMMARY{W}")
print(f"{Y}{'-'*50}{W}")

if score == 0:
    lvl, col = "PASS", G
    note = "No issues found -open-app approved"
elif score < 30:
    lvl, col = "LOW RISK", Y
    note = "Minor flags -manual review recommended"
elif score < 60:
    lvl, col = "MEDIUM RISK", Y
    note = "Issues detected -further review required"
else:
    lvl, col = "CRITICAL", R
    note = "Device suspicious -open-app NOT approved"

print(f"\n  {col}{BLD}[ {lvl} ]  score: {score}{W}")
print(f"  {col}{note}{W}\n")

if issues:
    print(f"  {R}{BLD}Detected issues:{W}")
    for txt, pts in issues:
        print(f"  {R}  . {txt}  (+{pts}){W}")

print(f"\n{Y}{BLD}{'='*50}{W}")
print(f"{Y}{BLD}   CHECK COMPLETE -ASLKEAR{W}")
print(f"{Y}{BLD}{'='*50}{W}\n")
